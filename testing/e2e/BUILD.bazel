# End-to-end integration tests exercising multiple decompiled FE7 subsystems
# together without requiring a retail GBA ROM.

load("//bazel:fe7_rules.bzl", "fe7_cc_test")

fe7_cc_test(
    name = "skirmish_integration_test",
    srcs = ["skirmish_integration_test.cc"],
    deps = [
        "//game:battle_hdr",
        "//game:item_hdr",
        "//game:register_all",
        "//game:unit_hdr",
        "//game/action:action",
        "//game/ai:ai",
        "//game/ai:ai_actions",
        "//game/ai:ai_combat",
        "//game/ai:ai_cp",
        "//game/ai:ai_decide",
        "//game/ai:ai_opcodes",
        "//game/ai:ai_script",
        "//game/battle:battle",
        "//game/battle:battle_exp",
        "//game/battle:battle_sim",
        "//game/engine:proc",
        "//game/engine:rng",
        "//game/item:item",
        "//game/map:map",
        "//game/map:trap",
        "//game/phase:phase",
        "//game/support:support",
        "//game/unit:unit",
        "//runtime:dispatch",
        "//runtime:gba_ptr",
        "@abseil-cpp//absl/base:nullability",
    ],
)
