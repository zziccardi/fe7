# Decompiled game subsystems and canonical headers (Phase 3+).
# Targets here may only depend on //game/... and
# //runtime:{gba_ptr,gba_hal,dispatch}.

load("//bazel:fe7_rules.bzl", "fe7_cc_test", "fe7_game_cc_library")

package(default_visibility = [
    "//game:__subpackages__",
    "//runtime:__subpackages__",
    "//testing:__subpackages__",
])

fe7_game_cc_library(
    name = "proc_hdr",
    hdrs = ["proc.h"],
    deps = ["//runtime:gba_ptr"],
)

fe7_game_cc_library(
    name = "battle_hdr",
    hdrs = ["battle.h"],
    deps = [
        ":unit_hdr",
        "//runtime:gba_ptr",
    ],
)

fe7_game_cc_library(
    name = "item_hdr",
    hdrs = ["item.h"],
    deps = ["//runtime:gba_ptr"],
)

fe7_game_cc_library(
    name = "unit_hdr",
    hdrs = ["unit.h"],
    deps = ["//runtime:gba_ptr"],
)

fe7_cc_test(
    name = "headers_test",
    srcs = ["headers_test.cc"],
    deps = [
        ":battle_hdr",
        ":item_hdr",
        ":proc_hdr",
        ":unit_hdr",
        "//runtime:gba_ptr",
    ],
)

fe7_game_cc_library(
    name = "register_all",
    srcs = ["register_all.cc"],
    hdrs = ["register_all.h"],
    deps = [
        "//game/action:action",
        "//game/ai:ai",
        "//game/ai:ai_actions",
        "//game/ai:ai_combat",
        "//game/ai:ai_cp",
        "//game/ai:ai_decide",
        "//game/ai:ai_opcodes",
        "//game/ai:ai_script",
        "//game/ai:ai_staff_loot",
        "//game/battle:battle",
        "//game/battle:battle_exp",
        "//game/battle:battle_gen",
        "//game/battle:battle_sim",
        "//game/engine:clock",
        "//game/engine:proc",
        "//game/engine:rng",
        "//game/item:item",
        "//game/map:ballista",
        "//game/map:map",
        "//game/map:map_range",
        "//game/map:trap",
        "//game/phase:phase",
        "//game/support:support",
        "//game/unit:unit",
    ],
)
