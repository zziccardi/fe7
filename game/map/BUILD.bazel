# 2D tile-map helpers, range diamonds, and BFS pathfinding (Wave 2).

load("//bazel:fe7_rules.bzl", "fe7_cc_test", "fe7_game_cc_library")

package(default_visibility = [
    "//game:__subpackages__",
    "//runtime:__subpackages__",
    "//testing:__subpackages__",
])

fe7_game_cc_library(
    name = "map",
    srcs = ["map.cc"],
    hdrs = ["map.h"],
    deps = [
        "//game:unit_hdr",
        "//runtime:dispatch",
        "//runtime:gba_ptr",
        "@abseil-cpp//absl/base:nullability",
    ],
)

fe7_cc_test(
    name = "map_test",
    srcs = ["map_test.cc"],
    deps = [
        ":map",
        "//runtime:dispatch",
        "//runtime:gba_ptr",
    ],
)

fe7_game_cc_library(
    name = "trap",
    srcs = ["trap.cc"],
    hdrs = ["trap.h"],
    deps = [
        ":map",
        "//game:unit_hdr",
        "//game/phase:phase",
        "//game/unit:unit",
        "//runtime:dispatch",
        "//runtime:gba_ptr",
        "@abseil-cpp//absl/base:nullability",
    ],
)

fe7_cc_test(
    name = "trap_test",
    srcs = ["trap_test.cc"],
    deps = [
        ":map",
        ":trap",
        "//game:unit_hdr",
        "//game/phase:phase",
        "//game/unit:unit",
        "//runtime:gba_ptr",
    ],
)
