# Turn flow, phase management, faction queries, and gold helpers (Wave 3).

load("//bazel:fe7_rules.bzl", "fe7_cc_test", "fe7_game_cc_library")

package(default_visibility = [
    "//game:__subpackages__",
    "//runtime:__subpackages__",
    "//testing:__subpackages__",
])

fe7_game_cc_library(
    name = "phase",
    srcs = ["phase.cc"],
    hdrs = ["phase.h"],
    deps = [
        "//game:proc_hdr",
        "//game:unit_hdr",
