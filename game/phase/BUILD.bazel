fe7_cc_test(
    name = "phase_test",
    srcs = ["phase_test.cc"],
    deps = [
        ":phase",
        "//game:proc_hdr",
        "//game:unit_hdr",
        "//game/engine:proc",
        "//game/unit:unit",
        "//runtime:dispatch",
        "//runtime:gba_ptr",
    ],
)
