load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:fe7_rules.bzl", "FE7_RUNTIME_COPTS", "fe7_cc_test", "fe7_runtime_cc_library")

package(default_visibility = ["//visibility:public"])

fe7_runtime_cc_library(
    name = "gba_ptr",
    srcs = ["gba_ptr.cc"],
    deps = ["//include/runtime:gba_ptr"],
)

fe7_cc_test(
    name = "gba_ptr_test",
    srcs = ["gba_ptr_test.cc"],
    deps = [":gba_ptr"],
)

fe7_runtime_cc_library(
    name = "rom_loader",
    srcs = ["rom_loader.cc"],
    deps = ["//include/runtime:rom_loader"],
)

fe7_cc_test(
    name = "rom_loader_test",
    srcs = ["rom_loader_test.cc"],
    deps = [":rom_loader"],
)

fe7_runtime_cc_library(
    name = "dispatch",
    srcs = ["dispatch.cc"],
    deps = ["//include/runtime:dispatch"],
)

fe7_cc_test(
    name = "dispatch_test",
    srcs = ["dispatch_test.cc"],
    deps = [":dispatch"],
)

cc_library(
    name = "mgba_bridge",
    srcs = ["mgba_bridge.c"],
    hdrs = ["mgba_bridge.h"],
    copts = [
        "-std=c11",
        "-Wno-sign-conversion",
        "-Wno-conversion",
    ],
    deps = ["@mgba//:mgba_gba"],
)

fe7_runtime_cc_library(
    name = "mgba_hal",
    srcs = ["mgba_hal.cc"],
    deps = [
        ":dispatch",
        ":gba_ptr",
        ":mgba_bridge",
        ":rom_loader",
        "//include/runtime:gba_hal",
        "@mgba//:mgba_gba",
    ],
)

fe7_cc_test(
    name = "mgba_hal_test",
    srcs = ["mgba_hal_test.cc"],
    deps = [
        ":dispatch",
        ":gba_ptr",
        ":mgba_hal",
        ":rom_loader",
    ],
)

cc_binary(
    name = "fe7_headless",
    srcs = ["tas_runner.cc"],
    copts = FE7_RUNTIME_COPTS,
    deps = [
        ":dispatch",
        ":mgba_hal",
        ":rom_loader",
    ],
)

cc_binary(
    name = "fe7_native",
    srcs = ["sdl_frontend.cc"],
    copts = FE7_RUNTIME_COPTS,
    deps = [
        ":mgba_hal",
        ":rom_loader",
    ],
)
