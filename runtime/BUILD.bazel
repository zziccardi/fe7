load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:fe7_rules.bzl", "FE7_RUNTIME_COPTS", "fe7_cc_test", "fe7_runtime_cc_library")

package(default_visibility = ["//runtime:__subpackages__"])

# --- Game-visible runtime interface targets ---

fe7_runtime_cc_library(
    name = "gba_ptr",
    srcs = ["gba_ptr.cc"],
    hdrs = ["gba_ptr.h"],
    visibility = [
        "//game:__subpackages__",
        "//runtime:__subpackages__",
    ],
    deps = ["@abseil-cpp//absl/base:nullability"],
)

fe7_cc_test(
    name = "gba_ptr_test",
    srcs = ["gba_ptr_test.cc"],
    deps = [":gba_ptr"],
)

fe7_runtime_cc_library(
    name = "gba_hal",
    hdrs = ["gba_hal.h"],
    visibility = [
        "//game:__subpackages__",
        "//runtime:__subpackages__",
    ],
    deps = ["@abseil-cpp//absl/base:nullability"],
)

fe7_runtime_cc_library(
    name = "dispatch",
    srcs = ["dispatch.cc"],
    hdrs = ["dispatch.h"],
    visibility = [
        "//game:__subpackages__",
        "//runtime:__subpackages__",
    ],
    deps = [
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_map",
    ],
)

fe7_cc_test(
    name = "dispatch_test",
    srcs = ["dispatch_test.cc"],
    deps = [":dispatch"],
)

# --- Runtime-internal targets (not visible to //game) ---

fe7_runtime_cc_library(
    name = "rom_loader",
    srcs = ["rom_loader.cc"],
    hdrs = ["rom_loader.h"],
    deps = [
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

fe7_cc_test(
    name = "rom_loader_test",
    srcs = ["rom_loader_test.cc"],
    deps = [
        ":rom_loader",
        "@abseil-cpp//absl/status",
    ],
)

cc_library(
    name = "mgba_bridge",
    srcs = ["mgba_bridge.c"],
    hdrs = ["mgba_bridge.h"],
    copts = [
        "-std=c11",
        "-Wno-sign-conversion",
        "-Wno-conversion",
    ],
    deps = ["@mgba//:mgba_gba"],
)

fe7_runtime_cc_library(
    name = "trace_recorder",
    srcs = ["trace_recorder.cc"],
    hdrs = ["trace_recorder.h"],
    deps = [
        ":gba_ptr",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

fe7_runtime_cc_library(
    name = "mgba_hal",
    srcs = ["mgba_hal.cc"],
    deps = [
        ":dispatch",
        ":gba_hal",
        ":gba_ptr",
        ":mgba_bridge",
        ":rom_loader",
        ":trace_recorder",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/base:nullability",
        "@mgba//:mgba_gba",
    ],
)

fe7_cc_test(
    name = "mgba_hal_test",
    srcs = ["mgba_hal_test.cc"],
    deps = [
        ":dispatch",
        ":gba_ptr",
        ":mgba_hal",
        ":rom_loader",
    ],
)

fe7_runtime_cc_library(
    name = "diff_harness",
    srcs = ["diff_harness.cc"],
    hdrs = ["diff_harness.h"],
    deps = [
        ":dispatch",
        ":gba_ptr",
        ":trace_recorder",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

fe7_cc_test(
    name = "diff_harness_test",
    srcs = ["diff_harness_test.cc"],
    deps = [
        ":diff_harness",
        ":dispatch",
        ":gba_hal",
        ":gba_ptr",
        ":mgba_hal",
        ":rom_loader",
        ":trace_recorder",
    ],
)

cc_binary(
    name = "fe7_headless",
    srcs = ["tas_runner.cc"],
    copts = FE7_RUNTIME_COPTS,
    deps = [
        ":dispatch",
        ":gba_hal",
        ":gba_ptr",
        ":mgba_hal",
        ":rom_loader",
        ":trace_recorder",
        "//game:register_all",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/strings",
    ],
)

cc_binary(
    name = "fe7_diff",
    srcs = ["diff_runner.cc"],
    copts = FE7_RUNTIME_COPTS,
    deps = [
        ":diff_harness",
        ":dispatch",
        ":gba_hal",
        ":gba_ptr",
        ":mgba_hal",
        ":rom_loader",
        ":trace_recorder",
        "//game:battle_hdr",
        "//game:register_all",
        "//game:unit_hdr",
        "//game/battle:battle",
        "//game/battle:battle_sim",
        "//game/engine:clock",
        "//game/engine:proc",
        "//game/engine:rng",
        "//game/item:item",
        "//game/map:map",
        "//game/unit:unit",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
    ],
)

config_setting(
    name = "is_headless",
    values = {"define": "headless=true"},
)

cc_binary(
    name = "fe7_native",
    srcs = ["sdl_frontend.cc"],
    copts = FE7_RUNTIME_COPTS,
    local_defines = select({
        ":is_headless": [],
        "//conditions:default": ["FE7_HAS_SDL3=1"],
    }),
    deps = [
        ":gba_hal",
        ":mgba_hal",
        ":rom_loader",
        "//game:register_all",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
    ] + select({
        ":is_headless": [],
        "//conditions:default": ["@sdl3//:sdl3"],
    }),
)
